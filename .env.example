# ==============================================================================
# AEGIS.AI - Environment & System Configuration Template
# Only commit .env.example to version control. Do NOT commit .env files containing credentials.
# ==============================================================================

# --- Server & Networking Configuration ---
HOST=127.0.0.1
PORT=8000
WORKERS=4
ENVIRONMENT=production
LOG_LEVEL=info

# --- Caching & Latency Optimization ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Anomaly Detection Engine Parameters ---
LATENCY_TARGET_MS=100
ANOMALY_THRESHOLD=0.65
DRIFT_CONSECUTIVE_ANOMALIES=4
AUTO_RETRAIN_ENABLED=true
SEQUENCE_WINDOW_SIZE=10

# --- Deep Learning Model Parameters ---
LSTM_HIDDEN_DIM=32
LSTM_LATENT_DIM=16
LSTM_NUM_LAYERS=2
GNN_CONV_TYPE=GCN
GNN_HIDDEN_DIM=32

# --- Feature Store & Metrics ---
FEATURE_STORE_TTL_HOURS=24
PROMETHEUS_METRICS_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL_SEC=15
